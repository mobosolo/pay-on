# URL du back-end PAY-ON (Node/Express)
VITE_API_BASE_URL=http://localhost:3000

# Bascule globale mock / API réelle (true => réponses mockées localement)
VITE_USE_MOCK=false
VITE_PARTICIPANT_USER_ID=66666666-6666-6666-6666-666666666666
VITE_ORGANIZER_USER_ID=77777777-7777-7777-7777-777777777777
VITE_SCANNER_USER_ID=77777777-7777-7777-7777-777777777777
VITE_VOTE_OPTION_ID=

# Scénario de paiement simulé (cf. CONTRACTS.md section 4)
# Valeurs : success | pending | failure
# Par défaut : success. Modifiable aussi à chaud côté front via
#   sessionStorage.setItem('payon:payment-scenario', 'failure')
VITE_MOCK_PAYMENT_SCENARIO=success