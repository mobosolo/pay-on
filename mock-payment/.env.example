# --- Service mock paiement ---
# Port HTTP d'écoute du service mock
PORT=4001

# Secret HMAC-SHA256 utilisé pour signer les webhooks émis vers le back-end.
# Côté back-end, ce même secret est attendu dans la variable WEBHOOK_SECRET
# (cf. CONTRACTS.md §4 — le nom de variable change à la bascule Paygate).
MOCK_WEBHOOK_SECRET=dev_mock_secret_change_me

# URL du webhook back-end que ce service appelle après simulation.
# Doit pointer vers POST /api/webhooks/paiement du back-end.
BACKEND_WEBHOOK_URL=http://localhost:3000/api/webhooks/paiement

# Délai (ms) avant émission du webhook pour les scénarios success / failure.
# En production Paygate ce délai sera réel ; ici il est court pour permettre le test.
WEBHOOK_DELAY_MS=1500

# --- Base PostgreSQL ---
# Par défaut on tente la même base que le back-end (cf. backend/.env.example).
# Si la base n'est pas joignable, le service démarre quand même en mode "sans persistance"
# et logue un avertissement — voir README §"Mode dégradé".
DATABASE_URL="postgresql://neondb_owner:npg_GLPH9SCUE7RW@ep-purple-tree-ayyjmksh-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
