generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  participant
  organisateur
  vendeur
  staff_scan
}

enum EventStatut {
  brouillon
  publie
  presale
  live
  cloture
  annule
}

enum BilletStatut {
  valide
  scanne
  annule
  rembourse
}

enum TransactionStatut {
  en_attente
  succes
  echec
  rembourse
}

enum ProduitVendeurStatut {
  presale
  live
  epuise
  ferme
}

enum CommandeVendeurStatut {
  en_attente
  payee
  prete_retrait
  remise
  annulee
}

model Utilisateur {
  id             String   @id @default(uuid()) @db.Uuid
  email          String   @unique
  telephone      String?  @unique
  passwordHash   String   @map("password_hash")
  nomComplet     String   @map("nom_complet")
  role           UserRole
  createdAt      DateTime @default(now()) @map("created_at")
  isActive       Boolean  @default(true) @map("is_active")

  evenements     Evenement[] @relation("EvenementOrganisateur")
  transactions   Transaction[] @relation("TransactionAcheteur")
  billets        Billet[] @relation("BilletProprietaire")
  billetsScan    Billet[] @relation("BilletScanner")
  produits       ProduitVendeur[] @relation("ProduitVendeurVendeur")
  commandes      CommandeVendeur[] @relation("CommandeVendeurAcheteur")

  @@map("utilisateurs")
}

model Evenement {
  id             String       @id @default(uuid()) @db.Uuid
  organisateurId String       @map("organisateur_id") @db.Uuid
  organisateur   Utilisateur  @relation("EvenementOrganisateur", fields: [organisateurId], references: [id])
  titre          String
  description    String?
  statut         EventStatut  @default(brouillon)
  lieuNom        String       @map("lieu_nom")
  adresse        String
  ville          String
  dateDebut      DateTime     @map("date_debut")
  dateFin        DateTime     @map("date_fin")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  tiers          TierBillet[]
  voteOptions    VoteOption[]
  votes          Vote[]
  produits       ProduitVendeur[]

  @@map("evenements")
}

model TierBillet {
  id               String    @id @default(uuid()) @db.Uuid
  eventId          String    @map("event_id") @db.Uuid
  event            Evenement @relation(fields: [eventId], references: [id])
  nom              String
  prix             Decimal   @db.Decimal(10, 2)
  devise           String
  quantiteTotale   Int       @map("quantite_totale")
  quantiteVendue   Int       @default(0) @map("quantite_vendue")
  ventesDebut      DateTime? @map("ventes_debut")
  ventesFin        DateTime? @map("ventes_fin")
  isActive         Boolean   @default(true) @map("is_active")

  billets          Billet[]

  @@map("tier_billets")
}

model Billet {
  id                 String        @id @default(uuid()) @db.Uuid
  tierId             String        @map("tier_id") @db.Uuid
  tier               TierBillet    @relation(fields: [tierId], references: [id])
  proprietaireUserId String        @map("proprietaire_user_id") @db.Uuid
  proprietaireUser   Utilisateur   @relation("BilletProprietaire", fields: [proprietaireUserId], references: [id])
  qrCode            String?       @unique @map("qr_code")
  statut            BilletStatut  @default(valide)
  transactionId      String        @map("transaction_id") @db.Uuid
  transaction        Transaction   @relation(fields: [transactionId], references: [id])
  scannedAt          DateTime?     @map("scanned_at")
  scannedByUserId    String?       @map("scanned_by_user_id") @db.Uuid
  scannedByUser      Utilisateur?  @relation("BilletScanner", fields: [scannedByUserId], references: [id])
  pointEntree        String?       @map("point_entree")
  createdAt          DateTime      @default(now()) @map("created_at")

  votes              Vote[]

  @@map("billets")
}

model Transaction {
  id                 String                @id @default(uuid()) @db.Uuid
  userId             String                @map("user_id") @db.Uuid
  user               Utilisateur           @relation("TransactionAcheteur", fields: [userId], references: [id])
  montant            Decimal               @db.Decimal(10, 2)
  devise             String
  statut             TransactionStatut     @default(en_attente)
  referenceExterne   String?               @map("reference_externe")
  provider           String?
  splitOrganisateur  Decimal?              @db.Decimal(10, 2) @map("split_organisateur")
  splitVendeur       Decimal?              @db.Decimal(10, 2) @map("split_vendeur")
  splitPlateforme    Decimal?              @db.Decimal(10, 2) @map("split_plateforme")
  splitNote          String?               @map("split_note")
  failureReason      String?               @map("failure_reason")
  confirmedAt        DateTime?             @map("confirmed_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  billets            Billet[]
  commandesVendeur   CommandeVendeur[]

  @@map("transactions")
}

model VoteOption {
  id         String    @id @default(uuid()) @db.Uuid
  eventId    String    @map("event_id") @db.Uuid
  event      Evenement @relation(fields: [eventId], references: [id])
  libelle    String
  createdAt  DateTime  @default(now()) @map("created_at")

  votes      Vote[]

  @@map("vote_options")
}

model Vote {
  id            String      @id @default(uuid()) @db.Uuid
  billetId      String      @map("billet_id") @db.Uuid
  billet        Billet      @relation(fields: [billetId], references: [id])
  eventId       String      @map("event_id") @db.Uuid
  event         Evenement   @relation(fields: [eventId], references: [id])
  voteOptionId  String      @map("vote_option_id") @db.Uuid
  voteOption    VoteOption  @relation(fields: [voteOptionId], references: [id])
  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([billetId, eventId])
  @@map("votes")
}

model ProduitVendeur {
  id             String               @id @default(uuid()) @db.Uuid
  vendeurUserId  String               @map("vendeur_user_id") @db.Uuid
  vendeurUser    Utilisateur          @relation("ProduitVendeurVendeur", fields: [vendeurUserId], references: [id])
  eventId        String               @map("event_id") @db.Uuid
  event          Evenement            @relation(fields: [eventId], references: [id])
  nom            String
  description    String?
  prix           Decimal              @db.Decimal(10, 2)
  devise         String
  stock          Int
  statut         ProduitVendeurStatut @default(presale)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  commandes      CommandeVendeur[]

  @@map("produits_vendeur")
}

model CommandeVendeur {
  id                String                 @id @default(uuid()) @db.Uuid
  produitId         String                 @map("produit_id") @db.Uuid
  produit           ProduitVendeur         @relation(fields: [produitId], references: [id])
  acheteurUserId    String                 @map("acheteur_user_id") @db.Uuid
  acheteurUser      Utilisateur            @relation("CommandeVendeurAcheteur", fields: [acheteurUserId], references: [id])
  quantite          Int
  montantTotal      Decimal                @db.Decimal(10, 2) @map("montant_total")
  statut            CommandeVendeurStatut  @default(en_attente)
  transactionId     String                 @map("transaction_id") @db.Uuid
  transaction       Transaction            @relation(fields: [transactionId], references: [id])
  qrCodeRetrait     String?                @unique @map("qr_code_retrait")
  retraitScannedAt   DateTime?              @map("retrait_scanned_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  @@map("commandes_vendeur")
}

model MockTransaction {
  transactionId   String    @id @db.Uuid @map("transaction_id")
  referenceExterne String   @map("reference_externe")
  status          String
  scenario        String?
  createdAt       DateTime  @default(now()) @map("created_at")
  webhookSentAt   DateTime? @map("webhook_sent_at")

  @@map("mock_transactions")
}
